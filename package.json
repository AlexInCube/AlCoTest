{
  "name": "aicbot",
  "version": "3.9.0-dev",
  "description": "Discord Bot for playing music",
  "main": "build/main.js",
  "scripts": {
    "build": "tsc",
    "development": "tsc&& cross-env NODE_ENV=development node --trace-deprecation --trace-warnings --disable-warning=DEP0190 build/main.js",
    "production": "cross-env NODE_ENV=production node build/main.js",
    "test": "tsc&& cross-env NODE_ENV=development node --test",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "lint": "oxlint --deny-warnings src",
    "format": "oxfmt src",
    "format:check": "oxfmt --check src"
  },
  "type": "module",
  "keywords": [],
  "author": "AlexInCube",
  "license": "ISC",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@discordjs/opus": "^0.10.0",
    "@discordjs/rest": "2.5.1",
    "@discordjs/voice": "0.18.0",
    "@distube/direct-link": "1.0.1",
    "@distube/file": "1.0.1",
    "@distube/soundcloud": "2.0.4",
    "@distube/spotify": "2.0.2",
    "@distube/youtube": "1.0.4",
    "@distube/yt-dlp": "2.0.1",
    "@distube/ytsr": "2.0.4",
    "cross-env": "7.0.3",
    "discord.js": "14.20.0",
    "distube": "5.0.7",
    "distube-apple-music": "0.1.0",
    "distube-vk-music-plugin": "2.0.3",
    "distube-yandex-music-plugin": "1.0.5",
    "dotenv": "16.5.0",
    "genius-lyrics": "4.4.7",
    "i18next": "25.2.1",
    "i18next-fs-backend": "2.6.0",
    "mongoose": "8.16.0",
    "node-os-utils": "1.3.7",
    "prism-media": "1.3.5",
    "sodium-native": "5.0.6",
    "soundcloud.ts": "0.6.5",
    "uuid": "11.1.0",
    "zod": "3.25.67"
  },
  "devDependencies": {
    "@types/node": "24.0.3",
    "@types/node-os-utils": "1.3.4",
    "@types/uuid": "10.0.0",
    "knip": "6.44.2",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "typescript": "5.8.3"
  }
}
